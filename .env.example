# ── Single-host deployment (docker-compose.yaml) ──────────────────────────
# Скопируй в ".env" и впиши РЕАЛЬНЫЕ значения. ".env" НЕ коммитится (.gitignore).
# Для мульти-машинного варианта см. .env.multi.example.

# IP машины с Kafka + gateway. Для одиночного хоста оставь host.docker.internal.
CORE_HOST=host.docker.internal

# Реальный IP ноута A в LAN (локальный DNS отдаёт его по bank.lan / game.lan).
LAN_IP=192.168.1.10

# JWT-секрет (должен быть валидным Base64). Сгенерировать:
#   openssl rand -base64 48
APP_JWT_SECRET=__GENERATE_ME__openssl_rand_base64_48__

# Пароль БД — используется Postgres и всеми сервисами. Сгенерировать:
#   openssl rand -hex 24
DB_PASSWORD=__SET_A_STRONG_PASSWORD__

# Стартовый администратор (account-service). ОБЯЗАТЕЛЬНО смени пароль.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__SET_A_STRONG_PASSWORD__

# Опциональный hack-токен аудита ("флешка бога"). Пусто = фича выключена.
AUDIT_HACK_TOKEN=
