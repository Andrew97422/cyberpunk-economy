# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe misparses them.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts and Maven wrapper must stay LF even on Windows checkouts.
*.sh   text eol=lf
mvnw   text eol=lf

# Binary assets — never diff or normalize.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.tar  binary
*.zip  binary

# Generated lockfiles: keep out of diffs and language stats.
package-lock.json  linguist-generated=true -diff

# Language stats: don't let ops/docs skew the repo language breakdown.
ИНСТРУКЦИЯ/**      linguist-documentation
docs/**            linguist-documentation
