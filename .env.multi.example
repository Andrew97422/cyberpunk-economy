# ── Multi-machine deployment (.env) ───────────────────────────────────────
# Copy to ".env" on EACH machine and fill in REAL values. Do NOT commit ".env".
#
# CORE_HOST = the LAN IP of machine 1 (the one running Kafka + gateway).
# Use the SAME value on all three machines (it is machine 1's IP everywhere):
#   - on machine 1 it tells Kafka which address to advertise to the others;
#   - on machines 2 & 3 it tells the services where to find Kafka.
CORE_HOST=192.168.1.10

# JWT secret — only the CORE machine (gateway) uses it. Must be valid Base64.
# Generate a fresh one:  openssl rand -base64 48
APP_JWT_SECRET=__GENERATE_ME__base64_48_bytes__

# Database password (used by Postgres + every service). Generate a strong one:
#   openssl rand -base64 24
DB_PASSWORD=__SET_A_STRONG_PASSWORD__

# Bootstrap admin (account-service, machine 2). CHANGE THE PASSWORD.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__SET_A_STRONG_PASSWORD__

# Optional: audit "God's flash drive" hack token (audit-service, machine 3).
AUDIT_HACK_TOKEN=

# DB names/users default to postgres/<svc>_db. Override per service if needed.
